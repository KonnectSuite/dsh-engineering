{
  "name": "dsh-engineering",
  "version": "0.1.2",
  "description": "AryaAI engineering bundle: one install surface and one tool-exposure policy for the Studio 5000 L5X and FactoryTalk View plugins, with skill links for Optix, MotionWorks IEC and CAD.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "engineering",
    "automation",
    "plc",
    "studio-5000",
    "factorytalk",
    "motionworks"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonnectSuite/dsh-engineering.git"
  },
  "homepage": "https://github.com/KonnectSuite/dsh-engineering#readme",
  "bugs": {
    "url": "https://github.com/KonnectSuite/dsh-engineering/issues"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --import tsx --test test/patch.spec.mjs test/docs.spec.mjs test/tool-reference.spec.mjs",
    "docs:tools": "tsx scripts/gen-tool-reference.ts",
    "docs:check": "tsx scripts/gen-tool-reference.ts --check"
  },
  "dependencies": {
    "dsh-engineering-ftview": "workspace:*",
    "dsh-engineering-ftview-viewer": "workspace:*",
    "dsh-engineering-l5x": "workspace:*",
    "dsh-engineering-l5x-viewer": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tool-skill": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0",
    "tsx": "^4.23.15"
  }
}
