{
  "name": "@aryacode/dsh-engineering",
  "version": "0.96.0",
  "description": "AryaCode engineering bundle: one install surface for the Studio 5000 L5X, FactoryTalk View ME, MotionWorks IEC and FactoryTalk Optix surfaces, one row per product, with the ladder and display previews.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "engineering",
    "automation",
    "plc",
    "studio-5000",
    "factorytalk",
    "motionworks"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonnectSuite/dsh-engineering.git"
  },
  "homepage": "https://github.com/KonnectSuite/dsh-engineering#readme",
  "bugs": {
    "url": "https://github.com/KonnectSuite/dsh-engineering/issues"
  },
  "files": [
    "cordis.patch.yml",
    "entries/**/*",
    "lib/**/*",
    "src/remote/**/*",
    "locale/*.json",
    "vendor/**/*",
    "README.md",
    "LICENSE",
    "presets/**/*"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": "^0.2.1-rc.3 || ^0.2.2-alpha.2"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-workspace-files",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "docs:tools": "tsx scripts/gen-tool-reference.ts",
    "docs:check": "tsx scripts/gen-tool-reference.ts --check && tsx scripts/gen-print-css.mts --check",
    "docs:figures": "node scripts/gen-doc-figures.mjs",
    "netlogic:sync": "node scripts/sync-netlogic.mjs",
    "optix:help": "node scripts/gen-optix-help.mjs",
    "optix:template": "node scripts/gen-optix-template.mjs",
    "resources:build": "node scripts/resources.mjs",
    "resources:check": "node scripts/resources.mjs --check",
    "build:faces": "node scripts/build-viewer-face.mjs && node scripts/build-ftview-face.mjs && node scripts/build-ecad-face.mjs",
    "build:client": "node scripts/build-viewer-face.mjs && node scripts/build-ftview-face.mjs && node scripts/build-ecad-face.mjs && node scripts/build-client.mjs",
    "e2e:ladder": "node packages/viewer/test/render/suite.mjs",
    "e2e:diagrams": "node packages/viewer/test/render/diagrams.mjs",
    "e2e:routines": "node packages/viewer/test/render/routines.mjs",
    "e2e:actions": "node packages/viewer/test/render/interactions.mjs",
    "e2e:instructions": "node packages/viewer/test/render/instructions.mjs",
    "assemble": "node scripts/assemble.mjs",
    "prepack": "node scripts/build-viewer-face.mjs && node scripts/build-ftview-face.mjs && node scripts/build-ecad-face.mjs && node scripts/build-client.mjs && node scripts/assemble.mjs",
    "docs:print-css": "tsx scripts/gen-print-css.mts",
    "docs:handbook": "python scripts/gen-handbook.py"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "@mlightcad/data-model": "1.15.21",
    "fast-xml-parser": "5.11.1",
    "fast-xml-validator": "1.4.2",
    "js-yaml": "^4.1.0",
    "playwright-core": "1.61.1",
    "st-ethernet-ip": "2.7.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-compaction-basic": "^0.2.1-rc.3 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "^0.2.1-rc.3 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-skill": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.3 || ^0.2.2-alpha.2",
    "@deepseek-ai/dsh-util-values": "^0.2.1-rc.3 || ^0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-compaction-basic": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-alpha.3",
    "@deepseek-ai/dsh-util-values": "0.2.2-alpha.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json",
    "./l5x": "./entries/l5x.js",
    "./ftview": "./entries/ftview.js",
    "./mwi": "./entries/mwi.js",
    "./ecad": "./entries/ecad.js",
    "./optix": "./entries/optix.js",
    "./l5x/read": "./vendor/l5x/lib/index.js",
    "./l5x/skill": "./vendor/l5x/lib/skill.js",
    "./l5x/editing": "./vendor/l5x/lib/editing.js",
    "./l5x/live": "./vendor/l5x/lib/live.js",
    "./l5x/studio": "./vendor/l5x/lib/studio.js",
    "./ftview/read": "./vendor/ftview/lib/index.js",
    "./ftview/skill": "./vendor/ftview/lib/skill.js",
    "./ftview/edit": "./vendor/ftview/lib/edit.js",
    "./ftview/studio": "./vendor/ftview/lib/studio.js",
    "./mwi/session": "./vendor/mwi/lib/index.js",
    "./mwi/read": "./vendor/mwi/lib/read.js",
    "./mwi/skill": "./vendor/mwi/lib/skill.js",
    "./mwi/verify": "./vendor/mwi/lib/verify.js",
    "./mwi/edit": "./vendor/mwi/lib/edit.js",
    "./resources": "./entries/resources.js",
    "./migration": "./entries/migration.js",
    "./plc5": "./entries/plc5.js",
    "./preset": "./entries/preset.js",
    "./arya-standard": "./presets/arya-standard/engine.js",
    "./arya-standard-policy": "./presets/arya-standard/policy.js"
  }
}
