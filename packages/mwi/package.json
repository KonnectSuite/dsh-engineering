{
  "name": "@aryacode/dsh-engineering-mwi",
  "version": "0.2.0",
  "description": "MotionWorks IEC 3 Pro IDE tools, redesigned for the engineering bundle.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./skill": {
      "types": "./lib/skill.d.ts",
      "default": "./lib/skill.js"
    },
    "./package.json": "./package.json",
    "./read": {
      "types": "./lib/read.d.ts",
      "default": "./lib/read.js"
    },
    "./verify": {
      "types": "./lib/verify.d.ts",
      "default": "./lib/verify.js"
    },
    "./edit": {
      "types": "./lib/edit.d.ts",
      "default": "./lib/edit.js"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "SKILL.md",
    "README.md",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "bridge/**",
    "code/**",
    "legacy/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "dsh": {
    "component": true
  }
}
