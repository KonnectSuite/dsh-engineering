{
  "name": "@aryacode/dsh-engineering-ftview",
  "version": "0.72.1",
  "description": "FactoryTalk View ME export analysis, redesigned for the engineering bundle.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./skill": {
      "types": "./lib/skill.d.ts",
      "default": "./lib/skill.js"
    },
    "./package.json": "./package.json",
    "./edit": {
      "types": "./lib/edit.d.ts",
      "default": "./lib/edit.js"
    },
    "./studio": {
      "types": "./lib/studio.d.ts",
      "default": "./lib/studio.js"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "SKILL.md",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "st-ethernet-ip": "2.7.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "license": "MIT",
  "dsh": {
    "component": true
  },
  "private": true
}
