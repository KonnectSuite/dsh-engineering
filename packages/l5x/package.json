{
  "name": "dsh-engineering-l5x",
  "version": "0.1.1",
  "private": true,
  "description": "Studio 5000 L5X: the rebuilt offline read surface for the AryaAI engineering suite.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./skill": {
      "types": "./lib/skill.d.ts",
      "default": "./lib/skill.js"
    },
    "./editing": {
      "types": "./lib/editing.d.ts",
      "default": "./lib/editing.js"
    },
    "./live": {
      "types": "./lib/live.d.ts",
      "default": "./lib/live.js"
    },
    "./studio": {
      "types": "./lib/studio.d.ts",
      "default": "./lib/studio.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "files": [
    "SKILL.md",
    "poll-worker.mjs",
    "studio-bridge/**/*.cs",
    "studio-bridge/*.csproj",
    "studio-bridge/NuGet.Config",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/client.js",
    "lib/client.js.map"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown --config tsdown.client.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build:client": "tsdown --config tsdown.client.config.ts"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.1",
    "fast-xml-validator": "1.4.2",
    "st-ethernet-ip": "2.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-tool",
        "@deepseek-ai/dsh-api-job-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "component": true
  }
}
