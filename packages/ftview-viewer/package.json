{
  "name": "dsh-engineering-ftview-viewer",
  "version": "0.1.0",
  "description": "FactoryTalk View ME display preview, folded into the engineering bundle.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar-documentpreview",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "component": true
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^6.0.3"
  }
}
