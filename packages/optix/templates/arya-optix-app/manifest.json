{
  "schemaVersion": 1,
  "id": "arya-optix-app",
  "version": "1.0.0",
  "title": "Arya Optix Application Starter",
  "description": "Branded starter with the operator shell already built: header band, native navigation rail, three designed screens, a confirm dialog, the vendor stylesheet bound to both engines and the bridge compiled in. Open it, connect the tags and design the screens.",
  "target": "industrial-pc",
  "questions": [
    {
      "id": "target",
      "question": "Is this project for a PC or industrial-PC running the HMI in a browser, or for an OptixPanel device?",
      "why": "This starter is the PC one, verified through the loopback web emulator; a panel target deploys natively and uses the arya-optix-panel blank starter instead."
    },
    {
      "id": "resolution",
      "question": "What is the display size in pixels the operator will see?",
      "why": "MainWindow carries 1280x800 and the shell, the rail and the three screens are laid out against that box; opts pass width/height and the scaffold resizes the window, but a very different box means re-running optix_ui shell so the bands and the rail are re-placed."
    },
    {
      "id": "project_name",
      "question": "Keep the shipped project name AryaOptixApp, or rename it?",
      "why": "The name lives in Nodes/AryaOptixApp.yaml, the .optix/.design files, the .csproj/.sln/.code-workspace and in /Objects/AryaOptixApp pointers inside the shell and the screens. The scaffold rewrites all of them; renaming by hand afterwards breaks the DynamicLinks."
    },
    {
      "id": "destination",
      "question": "Which empty directory should the copy go to?",
      "why": "Nothing is overwritten, and Studio opens the .optix file by absolute path."
    },
    {
      "id": "data_source",
      "question": "What will the HMI talk to: a Logix controller over EtherNet/IP, OPC UA, MQTT, or nothing yet?",
      "why": "The starter ships empty CommDrivers, OPC-UA and MQTT folders; the screens show mock values until tags are bound, so the connection is authored rather than switched."
    },
    {
      "id": "users",
      "question": "Does the operator log in, or does the runtime start anonymous?",
      "why": "The starter starts as Anonymous and ships no users; a login needs Security users and a LoginWindow, and the vendor LoginForm widget is imported on demand."
    },
    {
      "id": "branding",
      "question": "What is the product name and accent colour shown in the header?",
      "why": "ShellHeaderBrand and ShellHeaderChip are plain labels and the theme is the vendor FriendlyLight sheet; changing the name is one label edit, changing the palette means importing another StyleSheets item and binding it."
    }
  ],
