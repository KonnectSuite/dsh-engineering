/** Write (or verify) `docs/print.css` from the report's stylesheet. */

import { existsSync, readFileSync, writeFileSync } from 'node:fs'
import { REPORT_STYLESHEET } from '../packages/l5x/src/engine/report-styles.ts'

const header = `/* Generated by scripts/gen-print-css.mts from packages/l5x/src/engine/report-styles.ts.
 * Do not edit this file: a generated report and the handbook are printed with one stylesheet. */
`
const path = new URL('../docs/print.css', import.meta.url)
const wanted = `${header}${REPORT_STYLESHEET.trimEnd()}\n`

if (process.argv.includes('--check')) {
  const existing = existsSync(path) ? readFileSync(path, 'utf8') : ''
  if (existing !== wanted) {
    console.error('gen-print-css: docs/print.css differs from the stylesheet; run `pnpm docs:print-css`.')
    process.exit(1)
  }
  console.log('gen-print-css: docs/print.css is up to date.')
} else {
  writeFileSync(path, wanted)
  console.log(`gen-print-css: wrote docs/print.css (${wanted.length} bytes)`)
}
