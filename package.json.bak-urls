{
  "name": "dsh-engineering",
  "version": "0.1.0",
  "description": "AryaAI engineering bundle: one install surface and one tool-exposure policy for the Studio 5000 L5X, FactoryTalk View, FactoryTalk Optix, MotionWorks IEC and CAD plugins.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "bundle",
    "engineering",
    "automation",
    "plc",
    "studio-5000",
    "factorytalk",
    "motionworks"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KonnectSuite/dsh-engineering.git"
  },
  "homepage": "https://github.com/KonnectSuite/dsh-engineering#readme",
  "bugs": {
    "url": "https://github.com/KonnectSuite/dsh-engineering/issues"
  },
  "files": [
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test test/patch.spec.mjs test/docs.spec.mjs"
  },
  "dependencies": {
    "dsh-engineering-l5x": "workspace:*",
    "dsh-engineering-l5x-viewer": "workspace:*",
    "dsh-engineering-ftview": "workspace:*",
    "dsh-engineering-ftview-viewer": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tool-skill": "^0.2.0-rc.2"
  },
  "devDependencies": {
    "js-yaml": "^4.1.0"
  }
}
