{
  "source": {
    "package": "dsh-tool-motionworks-iec",
    "version": "0.7.0"
  },
  "targetRows": [
    {
      "id": "mwi-session",
      "default": "on",
      "purpose": "Find, stage, open and close the IDE project; report IDE state."
    },
    {
      "id": "mwi-read",
      "default": "on",
      "purpose": "Read the live project model, code, help and review evidence."
    },
    {
      "id": "mwi-verify",
      "default": "on",
      "purpose": "Compile, read diagnostics and verify a staged change."
    },
    {
      "id": "mwi-edit",
      "default": "off",
      "purpose": "Stage edits and apply them to the staged project."
    },
    {
      "id": "mwi-skill",
      "default": "on",
      "purpose": "The motionworks-iec guidance."
    }
  ],
  "targetTools": [
    {
      "name": "mw_project_find",
      "row": "mwi-session",
      "intent": "List workspace projects and the staged copy state."
    },
    {
      "name": "mw_ide_status",
      "row": "mwi-session",
      "intent": "Report IDE presence, project identity, active view, modals and compile state."
    },
    {
      "name": "mw_ide_start",
      "row": "mwi-session",
      "intent": "Start or attach the IDE, resolving trial and wrapper preconditions."
    },
    {
      "name": "mw_project_stage",
      "row": "mwi-session",
      "intent": "Copy a workspace project into the staging area and verify the copy."
    },
    {
      "name": "mw_project_open",
      "row": "mwi-session",
      "intent": "Open the staged project; refuse a stale wrapper and repair it with consent."
    },
    {
      "name": "mw_worksheet_open",
      "row": "mwi-session",
      "intent": "Open one code or variable worksheet by saved identity and verify the active view."
    },
    {
      "name": "mw_project_close",
      "row": "mwi-session",
      "intent": "Close the IDE project with explicit consent."
    },
    {
      "name": "mw_project_overview",
      "row": "mwi-read",
      "intent": "Project summary: languages, counts, tasks, warnings and coverage."
    },
    {
      "name": "mw_list",
      "row": "mwi-read",
      "intent": "List POUs, variables, globals, types, tasks, libraries or blocks with filter and paging."
    },
    {
      "name": "mw_get",
      "row": "mwi-read",
      "intent": "Read one POU body with declarations, one type, task, block interface or I/O map."
    },
    {
      "name": "mw_search",
      "row": "mwi-read",
      "intent": "Find literal text across staged POU code."
    },
    {
      "name": "mw_references",
      "row": "mwi-read",
      "intent": "Find where one symbol is read or written across POUs."
    },
    {
      "name": "mw_review",
      "row": "mwi-read",
      "intent": "Static review: scope and type checks, bounds, unsupported constructs, graphical listing."
    },
    {
      "name": "mw_help",
      "row": "mwi-read",
      "intent": "Search installed help and reviewed references; sync the reference index."
    },
    {
      "name": "mw_compile",
      "row": "mwi-verify",
      "intent": "Run Make, Build or report compile state in one intent."
    },
    {
      "name": "mw_diagnostics",
      "row": "mwi-verify",
      "intent": "Read the IDE error list and map exact text to documented causes."
    },
    {
      "name": "mw_verify",
      "row": "mwi-verify",
      "intent": "Capture a baseline, compare saved/native state and verify a staged change."
    },
    {
      "name": "mw_edit_code",
      "row": "mwi-edit",
      "intent": "Replace one ST or IL body using an expected body hash."
    },
    {
      "name": "mw_edit_variables",
      "row": "mwi-edit",
      "intent": "Add, edit, delete or group one declaration through the native API."
    },
    {
      "name": "mw_edit_structure",
      "row": "mwi-edit",
      "intent": "Create, copy, rename, delete, convert or task-assign a POU."
    },
    {
      "name": "mw_insert_block",
      "row": "mwi-edit",
      "intent": "Insert one FB instance and its bound ST call."
    },
    {
      "name": "mw_transfer_pou",
      "row": "mwi-edit",
      "intent": "Export one POU package and import it into the staged project."
    },
    {
      "name": "mw_validate",
      "row": "mwi-edit",
      "intent": "Validate staged edits against the saved project before applying."
    },
    {
      "name": "mw_apply",
      "row": "mwi-edit",
      "intent": "Write the staged edits through the IDE, save and sync back with consent."
    }
  ],
