node_modules/
*.tgz
*.log
*.err
packages/*/lib/
# Only the assembled root tree is ignored: `vendor/<component>` is written by
# `npm run assemble`, while a package may carry its own vendored sources (the
# workspace address helpers at packages/viewer/src/client/vendor) that must be
# tracked.
/vendor/
__pycache__/
*.pyc
/mwi-manual.mts

# The ladder face's end-to-end harness builds its page, its vendored react and
# its screenshots here; all of it is regenerated by `npm run e2e:ladder`.
.harness/
.harness-vendor/

# Optix is the one component with no source in this repository: the tree under
# packages/optix is the published build, so its lib/ is the source of truth and
# must be tracked. The other components' lib/ is output of `pnpm build`.
!packages/optix/lib/

# ladder preview artifacts
.l5x-preview/
.l5x-preview-test/
.l5x-diagram/
/tmp/

# Preview and harness output: DXF/DWG conversions from the print corpus, the
# headless viewer's shots and its per-run Chrome profile, FactoryTalk View render
# previews. Every tree here is regenerated by the script that wrote it, no
# document links any of them, and the profile alone costs over a hundred
# megabytes. `packages/ecad/test/client/screenshot-harness.mjs` writes into it.
/artifacts/

# Session scratch: exported-session extracts, live-verification logs and probe output.
.scratch/
.tmp-visual*.png

# A workspace-local pnpm store created by a tool run; pnpm's real store lives
# outside the checkout and this directory is empty scratch.
/.pnpm-store/
