node_modules/
*.tgz
*.log
*.err
packages/*/lib/
# Only the assembled root tree is ignored: `vendor/<component>` is written by
# `npm run assemble`, while a package may carry its own vendored sources (the
# workspace address helpers at packages/viewer/src/client/vendor) that must be
# tracked.
/vendor/
__pycache__/
*.pyc
/mwi-manual.mts

# The ladder face's end-to-end harness builds its page, its vendored react and
# its screenshots here; all of it is regenerated by `npm run e2e:ladder`.
.harness/
.harness-vendor/

# Optix is the one component with no source in this repository: the tree under
# packages/optix is the published build, so its lib/ is the source of truth and
# must be tracked. The other components' lib/ is output of `pnpm build`.
!packages/optix/lib/

# ladder preview artifacts
.l5x-preview/
.l5x-preview-test/
.l5x-diagram/
/tmp/

# The DWG round-trip specs convert the whole print corpus into these two trees on
# every run; both are regenerated by packages/ecad/test/{corpus,dxf}.spec.mjs and
# neither is a figure any document links.
/artifacts/DWG/
/artifacts/DXF/

# The headless viewer harness writes its shots and its per-run Chrome profile
# here. No document links the shots, and a profile costs over a hundred
# megabytes, so the tree is regenerated by packages/ecad/test/client/
# screenshot-harness.mjs rather than tracked.
/artifacts/ecad-face-shots/

# Session scratch: exported-session extracts, live-verification logs and probe output.
.scratch/
